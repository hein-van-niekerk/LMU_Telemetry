<Window x:Class="LMU_Telemetry.Views.CalibrationHelper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Map Calibration Helper" Height="600" Width="900"
        Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10">
            Find calibration points by clicking on the track map where you know the GPS location.
            Then copy the telemetry GPS coordinates from the list below.
        </TextBlock>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Track Map Preview -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Margin="0,0,5,0">
                <Grid>
                    <Canvas x:Name="PreviewCanvas" Background="White" MouseDown="PreviewCanvas_MouseDown"/>
                    <TextBlock Text="No track map loaded" Foreground="#808080" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               x:Name="NoMapText" Visibility="Visible"/>
                </Grid>
            </Border>
            
            <!-- Right: GPS Data and Calibration Points -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- GPS Stats -->
                <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10" Margin="5,0,0,5">
                    <StackPanel>
                        <TextBlock Foreground="#CCCCCC" FontWeight="Bold" Margin="0,0,0,5">GPS Coordinate Range:</TextBlock>
                        <TextBlock x:Name="GpsRangeText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>
                
                <!-- Known Track Locations -->
                <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Margin="5,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="#CCCCCC" FontWeight="Bold" Padding="10,10,10,5">
                            Suggested Calibration Locations:
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SuggestedPoints" Padding="10,5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D2D30" Padding="8" Margin="0,2" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontWeight="Bold"/>
                                                    <TextBlock Foreground="#808080" FontSize="10" FontFamily="Consolas">
                                                        <Run Text="Lap Dist: "/><Run Text="{Binding LapDist, StringFormat=N0}"/><Run Text="m"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#808080" FontSize="10" FontFamily="Consolas">
                                                        <Run Text="GPS: "/><Run Text="{Binding Lat, StringFormat=F6}"/><Run Text=", "/><Run Text="{Binding Lon, StringFormat=F6}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Find in Data" Click="FindLocation_Click" 
                                                        Background="#007ACC" Foreground="White" Padding="8,4" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <!-- Map Click Info -->
                <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10" Margin="5,0,0,5">
                    <StackPanel>
                        <TextBlock Foreground="#CCCCCC" FontWeight="Bold" Margin="0,0,0,5">Last Clicked Map Position:</TextBlock>
                        <TextBlock x:Name="ClickedPosText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12" Text="Click on map..."/>
                    </StackPanel>
                </Border>
                
                <!-- Calibration Code Output -->
                <Border Grid.Row="3" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Margin="5,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="#CCCCCC" FontWeight="Bold" Padding="10,10,10,5">
                            Generated Calibration Code:
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="CalibrationCodeText" FontFamily="Consolas" FontSize="11"
                                     Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"
                                     Padding="10" IsReadOnly="True" TextWrapping="Wrap"
                                     Text="// Click on map and find GPS coordinates to generate code..."/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy Code to Clipboard" Click="CopyCode_Click" 
                    Background="#0E639C" Foreground="White" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="Close" Click="Close_Click" 
                    Background="#2D2D30" Foreground="#CCCCCC" Padding="15,8" BorderThickness="1" BorderBrush="#3E3E42"/>
        </StackPanel>
    </Grid>
</Window>
