<Window x:Class="LMU_Telemetry.Views.DevModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Map Dev Mode" Height="700" Width="1050"
        Background="#0D0D0D" Foreground="#C8C8C8"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark button style -->
        <Style x:Key="DevBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141414"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button (orange) -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource DevBtn}">
            <Setter Property="Background" Value="#3A2000"/>
            <Setter Property="Foreground" Value="#FFA040"/>
            <Setter Property="BorderBrush" Value="#7A4000"/>
        </Style>

        <!-- Danger button (red) -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource DevBtn}">
            <Setter Property="Background" Value="#2A0808"/>
            <Setter Property="Foreground" Value="#FF6060"/>
            <Setter Property="BorderBrush" Value="#6A1010"/>
        </Style>

        <!-- ListBox item style -->
        <Style x:Key="LapItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A3A5A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header / track key -->
            <RowDefinition Height="*"/>     <!-- tab content -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════ HEADER ═══════════════════════════ -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙ DEV MODE" Foreground="#FFA040" FontSize="13" FontWeight="Bold"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Track:" Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TrackKeyText" Text="— (no session)" Foreground="#4A9ECC"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════ TAB CONTENT ══════════════════════════ -->
        <TabControl Grid.Row="1" Background="#0D0D0D" BorderBrush="#2A2A2A"
                    Foreground="#C0C0C0">

            <!-- ── TAB 1: RECORD ───────────────────────────────────────────── -->
            <TabItem Header="  RECORD  " Foreground="#C0C0C0">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lap list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="RECORDED LAPS" Foreground="#555555"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>

                        <ListBox x:Name="LapListBox" Grid.Row="1"
                                 Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1"
                                 SelectionChanged="LapListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LapItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsKept}"
                                                  Checked="LapKeepCheckBox_Changed"
                                                  Unchecked="LapKeepCheckBox_Changed"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Right action column -->
                    <StackPanel Grid.Column="1" Margin="12,28,0,0">
                        <Button x:Name="StartStopRecordButton" Content="▶ START RECORDING"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Click="StartStopRecordButton_Click"/>
                        <Button x:Name="LoadRecordingButton" Content="📂 Load Recording…"
                                Style="{StaticResource DevBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                ToolTip="Extract laps from an existing .duckdb telemetry recording"
                                Click="LoadRecordingButton_Click"/>
                        <Button x:Name="RefreshLapsButton" Content="↺ Refresh"
                                Style="{StaticResource DevBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                Click="RefreshLapsButton_Click"/>
                        <Button x:Name="DeleteLapButton" Content="🗑 Delete Selected"
                                Style="{StaticResource DangerBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0"
                                Click="DeleteLapButton_Click"/>

                        <Separator Margin="0,16,0,16" Background="#2A2A2A"/>

                        <TextBlock Text="RECORDING" Foreground="#555555"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RecordingStatusText" Text="Stopped"
                                   Foreground="#888888" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── TAB 2: GENERATE & PREVIEW ─────────────────────────────── -->
            <TabItem Header="  GENERATE &amp; PREVIEW  " Foreground="#C0C0C0">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview canvas -->
                    <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1">
                        <Canvas x:Name="PreviewCanvas"
                                SizeChanged="PreviewCanvas_SizeChanged"
                                Background="#0A0A0A"/>
                    </Border>

                    <!-- Right action column -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="CANDIDATE MAP" Foreground="#555555"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Button x:Name="GenerateButton" Content="⚡ Generate Candidate"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                Click="GenerateButton_Click"/>

                        <Button x:Name="SaveCandidateButton" Content="💾 Save to Library"
                                Style="{StaticResource DevBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                IsEnabled="False"
                                Click="SaveCandidateButton_Click"/>

                        <Button x:Name="DiscardCandidateButton" Content="✕ Discard"
                                Style="{StaticResource DangerBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0"
                                IsEnabled="False"
                                Click="DiscardCandidateButton_Click"/>

                        <Separator Margin="0,16,0,16" Background="#2A2A2A"/>

                        <TextBlock Text="CANDIDATE INFO" Foreground="#555555"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CandidateInfoText" Text="—"
                                   Foreground="#888888" FontFamily="Consolas" FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── TAB 3: LIBRARY ─────────────────────────────────────────── -->
            <TabItem Header="  LIBRARY  " Foreground="#C0C0C0">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Library list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SAVED MAPS" Foreground="#555555"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>

                        <ListBox x:Name="LibraryListBox" Grid.Row="1"
                                 Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1"
                                 SelectionChanged="LibraryListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LapItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding TrackKey}" Foreground="#4A9ECC"
                                                   FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#888888"
                                                   FontSize="10" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Right action column -->
                    <StackPanel Grid.Column="1" Margin="12,28,0,0">
                        <Button x:Name="RefreshLibraryButton" Content="↺ Refresh"
                                Style="{StaticResource DevBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                Click="RefreshLibraryButton_Click"/>
                        <Button x:Name="ImportMapButton" Content="📂 Import JSON…"
                                Style="{StaticResource DevBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                Click="ImportMapButton_Click"/>
                        <Button x:Name="DeleteLibraryEntryButton" Content="🗑 Delete Selected"
                                Style="{StaticResource DangerBtn}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0"
                                Click="DeleteLibraryEntryButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════ STATUS BAR ═══════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusBar" Text="Ready." Foreground="#777777"
                       FontFamily="Consolas" FontSize="10"/>
        </Border>
    </Grid>
</Window>
