<UserControl x:Class="LMU_Telemetry.Views.DetailedAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Background="#1E1E1E" Orientation="Vertical" Width="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <TextBlock Text="X Axis" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Time" GroupName="AxisMode" IsChecked="True" Tag="Time" Checked="AxisModeChanged" Foreground="#B0B0B0" Margin="0,0,8,0"/>
                <RadioButton Content="Lap Dist" GroupName="AxisMode" Tag="Distance" Checked="AxisModeChanged" Foreground="#B0B0B0"/>
            </StackPanel>

            <Expander Header="Speed &amp; Acceleration" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <Canvas x:Name="SpeedAccelCanvas" Height="260" Background="#111111" Margin="0,0,0,10"/>
                </StackPanel>
            </Expander>

            <Expander Header="G-Force &amp; Balance" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <Canvas x:Name="GForceCanvas" Height="260" Background="#111111" Margin="0,0,0,10"/>
                </StackPanel>
            </Expander>

            <Expander Header="Yaw &amp; Slip" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <Canvas x:Name="YawSlipCanvas" Height="260" Background="#111111" Margin="0,0,0,10"/>
                </StackPanel>
            </Expander>

            <Expander Header="Tyre Health" IsExpanded="True" Margin="0,0,0,10">
                <Border Background="#111111" Padding="8" CornerRadius="4">
                    <StackPanel>
                        <UniformGrid Columns="2" Rows="2" x:Name="TyreGrid" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Heatmap" Foreground="#A0A0A0" />
                            <Rectangle x:Name="TyreHeatBar" Height="8" Width="180" RadiusX="2" RadiusY="2" Fill="#2E7D32" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander Header="Brake System" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <Canvas x:Name="BrakeCanvas" Height="220" Background="#111111" Margin="0,0,0,10"/>
                </StackPanel>
            </Expander>

            <Expander Header="Aero &amp; Ride Height" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <Canvas x:Name="AeroCanvas" Height="220" Background="#111111" Margin="0,0,0,10"/>
                </StackPanel>
            </Expander>

            <Expander Header="Environment" IsExpanded="True" Margin="0,0,0,10">
                <UniformGrid Columns="2" Rows="2" x:Name="EnvironmentGrid" Margin="0,0,0,6"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
