<Window x:Class="LMU_Telemetry.Views.TelemetryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LMU_Telemetry.Views"
        Title="LMU Telemetry — Detail View"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- header bar -->
            <RowDefinition Height="*"/>    <!-- content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111111" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TELEMETRY DETAIL" Foreground="#CCCCCC"
                               FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderSubtitle" Text=""
                               Foreground="#444444" FontSize="11" FontFamily="Consolas"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-panel content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>     <!-- live channel values -->
                <ColumnDefinition Width="1"/>        <!-- divider -->
                <ColumnDefinition Width="*"/>        <!-- analysis graphs -->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#080808" BorderBrush="#1A1A1A" BorderThickness="0,0,0,0">
                <local:DetailedDataView x:Name="DataView"/>
            </Border>

            <Rectangle Grid.Column="1" Fill="#1A1A1A"/>

            <Border Grid.Column="2" Background="#0D0D0D">
                <local:DetailedAnalysisView x:Name="AnalysisView"/>
            </Border>
        </Grid>
    </Grid>
</Window>
