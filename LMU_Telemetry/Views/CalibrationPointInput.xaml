<Window x:Class="LMU_Telemetry.Views.CalibrationPointInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Calibration Point Details" Height="350" Width="450"
        Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap">
            Enter the GPS coordinates for this map location:
        </TextBlock>
        
        <!-- Map coordinates (read-only) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Foreground="#808080" FontSize="11" Margin="0,0,0,2">Map Coordinates (where you clicked):</TextBlock>
            <TextBlock x:Name="MapCoordsText" Foreground="#569CD6" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
        
        <!-- Point Name -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5">Point Name (e.g., "Start/Finish", "Turn 1"):</TextBlock>
            <TextBox x:Name="NameTextBox" Padding="5" FontSize="12" 
                     Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42"/>
        </StackPanel>
        
        <!-- Latitude -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5">GPS Latitude:</TextBlock>
            <TextBox x:Name="LatTextBox" Padding="5" FontSize="12" FontFamily="Consolas"
                     Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42"/>
        </StackPanel>
        
        <!-- Longitude -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5">GPS Longitude:</TextBlock>
            <TextBox x:Name="LonTextBox" Padding="5" FontSize="12" FontFamily="Consolas"
                     Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42"/>
        </StackPanel>
        
        <TextBlock Grid.Row="5" Foreground="#808080" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap">
            Tip: Use the suggested locations list to find GPS coordinates from your telemetry data.
        </TextBlock>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0"
                    Background="#2D2D30" Foreground="#CCCCCC" BorderBrush="#3E3E42"
                    Click="Cancel_Click"/>
            <Button Content="Add Point" Width="100" Height="30"
                    Background="#0E639C" Foreground="White" BorderBrush="#1177BB"
                    Click="AddPoint_Click"/>
        </StackPanel>
    </Grid>
</Window>
