<Window x:Class="LMU_Telemetry.Views.DeveloperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Telemetry — Developer Mode: Track Map Editor"
        Height="820" Width="1300"
        MinHeight="560" MinWidth="900"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111111" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DEVELOPER MODE" Foreground="#FFD700"
                               FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock Text="  ·  Track Map Editor" Foreground="#888888" Margin="4,0,0,0"/>
                    <TextBlock x:Name="StatusText" Text="" Foreground="#4EC26E" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Track map canvas -->
            <Border Grid.Column="0" Background="#080808">
                <Canvas x:Name="MapCanvas" Background="#080808" ClipToBounds="True"
                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"/>
            </Border>

            <Rectangle Grid.Column="1" Fill="#1A1A1A"/>

            <!-- Control panel -->
            <Border Grid.Column="2" Background="#0D0D0D">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="1. LOAD RECORDING" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <Button x:Name="LoadButton" Content="Load .duckdb File..." Click="LoadButton_Click"/>
                        <TextBlock x:Name="LoadedFileText" Text="No file loaded" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="2. SHOW RAW DRIVEN PATH" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <TextBlock Text="No automatic map generation - this is the raw recorded line, rendered the same way as the main window. Drive both track-limit edges and pick the lap that looks cleanest." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="Lap:"/>
                        <ComboBox x:Name="LapSelector" IsEnabled="False" SelectionChanged="LapSelector_SelectionChanged" Margin="0,0,0,6"/>
                        <TextBlock x:Name="MapInfoText" Text="" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="3. PLACE CORNERS" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <TextBlock Text="Click a marker to select. Drag to move. Toggle Add mode then click the track line to add - all corners are placed by hand, nothing is auto-detected." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ToggleButton x:Name="AddCornerToggle" Content="Add Corner Mode: OFF"
                                      Checked="AddCornerToggle_Checked" Unchecked="AddCornerToggle_Unchecked"
                                      Margin="0,0,0,6" Padding="8,5" IsEnabled="False"/>
                        <TextBlock x:Name="CornerCountText" Text="Corners: 0" Margin="0,0,0,12"/>

                        <Border x:Name="SelectedCornerPanel" BorderBrush="#2A2A2A" BorderThickness="1" Padding="8" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SelectedCornerHeader" Text="Selected: Corner #0" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,6"/>
                                <TextBlock Text="Name:"/>
                                <TextBox x:Name="CornerNameBox" TextChanged="CornerNameBox_TextChanged"/>
                                <TextBlock x:Name="SelectedCornerDetail" Text="" Margin="0,0,0,6"/>
                                <Button x:Name="DeleteCornerButton" Content="Delete This Corner" Click="DeleteCornerButton_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="4. SAVE" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <TextBlock Text="Track name:"/>
                        <TextBox x:Name="TrackNameBox"/>
                        <Button x:Name="SaveButton" Content="Save Track Map" Click="SaveButton_Click" IsEnabled="False"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
