<UserControl x:Class="LMU_Telemetry.Views.DetailedDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="DETAILED DATA" 
                   Foreground="#569CD6" FontSize="14" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="#252526" 
                    BorderBrush="#3E3E42" BorderThickness="1"
                    Margin="5">
            <TabControl.Resources>
                <!-- Tab Item Style -->
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid>
                                    <Border x:Name="Border" Background="#2D2D30" 
                                            BorderBrush="#3E3E42" BorderThickness="1,1,1,0"
                                            Margin="2,0,2,0" CornerRadius="3,3,0,0">
                                        <TextBlock Text="{TemplateBinding Header}" 
                                                   Foreground="#CCCCCC" 
                                                   FontSize="12" FontWeight="Bold"
                                                   Padding="15,8"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </Style>
            </TabControl.Resources>

            <!-- Channels Tab -->
            <TabItem Header="📊 CHANNELS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ChannelsPanel" Margin="10" Background="#1E1E1E"/>
                </ScrollViewer>
            </TabItem>

            <!-- Events Tab -->
            <TabItem Header="⚡ EVENTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EventsPanel" Margin="10" Background="#1E1E1E"/>
                </ScrollViewer>
            </TabItem>

            <!-- Summary Tab -->
            <TabItem Header="📈 SUMMARY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SummaryPanel" Margin="10" Background="#1E1E1E"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
