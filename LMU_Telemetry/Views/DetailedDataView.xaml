<UserControl x:Class="LMU_Telemetry.Views.DetailedDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#080808">
    <Grid>
        <TabControl Background="#080808" BorderBrush="#1A1A1A" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Border" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                        Padding="10,6" Margin="0,0,2,0">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="#444444"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#0D0D0D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#444444"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="CHANNELS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#080808">
                    <StackPanel x:Name="ChannelsPanel" Margin="0"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EVENTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#080808">
                    <StackPanel x:Name="EventsPanel" Margin="0"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SUMMARY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#080808">
                    <StackPanel x:Name="SummaryPanel" Margin="0"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
