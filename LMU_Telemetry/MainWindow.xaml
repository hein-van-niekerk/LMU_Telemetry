<Window x:Class="LMU_Telemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LMU_Telemetry.Views"
        Title="LMU Telemetry" Height="900" Width="1600"
        Background="#0D0D0D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: Toolbar -->
            <RowDefinition Height="82"/>     <!-- Row 1: Data strip -->
            <RowDefinition Height="*"/>      <!-- Row 2: Track + right panel -->
            <RowDefinition Height="280"/>    <!-- Row 3: Channel traces -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 0 — Toolbar                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#222222" BorderThickness="0,0,0,1" Panel.ZIndex="10">
            <Grid Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Controls row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Connection status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Margin="0,0,7,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="ConnectionDotBrush" Color="#CC3333"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="NO SIGNAL" Foreground="#CC3333"
                                   FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" MinWidth="110"/>
                        <Border Background="#0E2A0E" BorderBrush="#1A4A1A" BorderThickness="1"
                                CornerRadius="2" Padding="8,3" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="RecordDotBrush" Color="#4EC94E"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="FrameCountText" Text="REC  0 frames"
                                           Foreground="#4EC94E" FontSize="10" FontWeight="Bold"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#2A2A2A" Width="1" Margin="16,8"/>

                    <!-- Playback controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevLapButton" Click="PrevLapButton_Click"
                                Content="&#x25C4; LAP" Height="26" Width="58" Padding="4,0"
                                Background="#1A1A1A" Foreground="#888888"
                                BorderBrush="#2A2A2A" BorderThickness="1"
                                Cursor="Hand" ToolTip="Previous lap"
                                FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click"
                                Width="30" Height="30" Margin="6,0"
                                Cursor="Hand" ToolTip="Play / Pause">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Width="30" Height="30" CornerRadius="15"
                                                        Background="#1C1C1C" BorderBrush="#303030" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#101E2E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#0D1824"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Path x:Name="PlayPauseIcon"
                                  Fill="#B0B0B0" Data="M1,0 L1,10 L9,5 Z"
                                  Stretch="None" Width="10" Height="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="NextLapButton" Click="NextLapButton_Click"
                                Content="LAP &#x25BA;" Height="26" Width="58" Padding="4,0"
                                Background="#1A1A1A" Foreground="#888888"
                                BorderBrush="#2A2A2A" BorderThickness="1"
                                Cursor="Hand" ToolTip="Next lap"
                                FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="3" Fill="#2A2A2A" Width="1" Margin="16,8"/>

                    <!-- Speed multipliers -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="Speed2xButton" Click="Speed2xButton_Click"
                                Content="2×" Height="24" Width="34"
                                Background="#1A1A1A" Foreground="#666666"
                                BorderBrush="#2A2A2A" BorderThickness="1"
                                Cursor="Hand" FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="Speed4xButton" Click="Speed4xButton_Click"
                                Content="4×" Height="24" Width="34" Margin="4,0,0,0"
                                Background="#1A1A1A" Foreground="#666666"
                                BorderBrush="#2A2A2A" BorderThickness="1"
                                Cursor="Hand" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Right cluster -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="LapInfoText" Text="" Foreground="#4A9ECC"
                                   FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button x:Name="SaveRecordingButton" Click="SaveRecordingButton_Click"
                                Content="SAVE" Height="26" Padding="12,0"
                                Background="#1A1A1A" Foreground="#888888"
                                BorderBrush="#2A2A2A" BorderThickness="1"
                                Cursor="Hand" ToolTip="Save buffer to .duckdb"
                                FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="LoadRecordingButton" Click="LoadRecordingButton_Click"
                                Content="LOAD" Height="26" Padding="12,0" Margin="6,0,0,0"
                                Background="#0E3A5C" Foreground="#4A9ECC"
                                BorderBrush="#1A5A8C" BorderThickness="1"
                                Cursor="Hand" ToolTip="Load .duckdb recording"
                                FontSize="10" FontWeight="Bold"/>
                        <CheckBox x:Name="TrackMapToggle" IsChecked="True" Content="MAP"
                                  Margin="18,0,0,0" VerticalAlignment="Center"
                                  Foreground="#666666" FontSize="10" FontWeight="Bold"
                                  Checked="TrackMapToggle_Checked" Unchecked="TrackMapToggle_Checked"/>
                        <!-- Hidden generate/delete kept for code-behind compatibility -->
                        <Button x:Name="GenerateTrackMapButton" Click="GenerateTrackMapButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="DeleteTrackMapButton" Click="DeleteTrackMapButton_Click" Visibility="Collapsed"/>
                        <!-- DEV MODE button: only visible when IsDevModeEnabled is true -->
                        <Button x:Name="DevModeButton" Click="DevModeButton_Click"
                                Content="⚙ DEV" Height="26" Padding="10,0" Margin="10,0,0,0"
                                Background="#3A2000" Foreground="#FFA040"
                                BorderBrush="#7A4000" BorderThickness="1"
                                Cursor="Hand" ToolTip="Open Track Map Dev Mode"
                                FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- Time slider row -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="84"/>
                    </Grid.ColumnDefinitions>

                    <!-- Slider + marker overlay stacked -->
                    <Grid Grid.Column="0">
                        <Slider x:Name="TimeSlider"
                                Minimum="0" Maximum="100" Value="0"
                                ValueChanged="TimeSlider_ValueChanged"
                                IsEnabled="False"
                                Foreground="#0078D4" Background="#252525"
                                HorizontalAlignment="Stretch"
                                ToolTip="Scrub timeline"/>
                        <!-- Marker canvas sits on top, pointer-events off so slider still works -->
                        <Canvas x:Name="SliderMarkersCanvas"
                                IsHitTestVisible="False"
                                VerticalAlignment="Center"
                                Height="20"
                                Margin="7,0,7,0"/>
                    </Grid>

                    <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00.000"
                               Foreground="#888888" FontSize="11" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 1 — Data strip: Gear · RPM · Speed · Throttle · Brake · Lap  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <!-- Gear -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- RPM area -->
                    <ColumnDefinition Width="260"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Speed -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Throttle + Brake mini bars -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Stretch -->
                    <ColumnDefinition Width="*"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Lap / Sector / Delta -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- GEAR — large, prominent -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="GEAR" Foreground="#333333" FontSize="9" FontWeight="Bold"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DsGear" Text="—" Foreground="#F0C040"
                               FontSize="42" FontWeight="Bold" FontFamily="Consolas"
                               HorizontalAlignment="Center" LineHeight="44"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="#1E1E1E" Width="1" Margin="0,10"/>

                <!-- RPM bar + label -->
                <Grid Grid.Column="2" Margin="20,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RPM" Foreground="#333333" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DsRpmText" Grid.Column="1" Text="0" Foreground="#888888"
                                   FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- RPM bar track -->
                    <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="2" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DsRpmFilled" Width="0*"/>
                                <ColumnDefinition x:Name="DsRpmEmpty"  Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00509A" Offset="0"/>
                                        <GradientStop Color="#0096FF" Offset="0.55"/>
                                        <GradientStop Color="#FF8C00" Offset="0.82"/>
                                        <GradientStop Color="#FF1A1A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="DsRpmMax" Grid.Row="2" Text="" Foreground="#333333"
                               FontSize="9" FontFamily="Consolas" HorizontalAlignment="Right"/>
                </Grid>

                <Rectangle Grid.Column="3" Fill="#1E1E1E" Width="1" Margin="0,10"/>

                <!-- Speed -->
                <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="KM/H" Foreground="#333333" FontSize="9" FontWeight="Bold"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DsSpeed" Text="—" Foreground="#E0E0E0"
                               FontSize="36" FontWeight="Bold" FontFamily="Consolas"
                               HorizontalAlignment="Center" LineHeight="38"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="#1E1E1E" Width="1" Margin="0,10"/>

                <!-- Throttle + Brake mini inline bars -->
                <StackPanel Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0" Width="130">
                    <!-- Throttle row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="T" Foreground="#00C853" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#0D1A0D" CornerRadius="2" Height="7" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="DsThrottleFilled" Width="0*"/>
                                    <ColumnDefinition x:Name="DsThrottleEmpty"  Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#00C853" RadiusX="2" RadiusY="2"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DsThrottlePct" Grid.Column="2" Text="0%" Foreground="#00C853"
                                   FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Brake row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" Foreground="#F44336" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#1A0D0D" CornerRadius="2" Height="7" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="DsBrakeFilled" Width="0*"/>
                                    <ColumnDefinition x:Name="DsBrakeEmpty"  Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#F44336" RadiusX="2" RadiusY="2"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DsBrakePct" Grid.Column="2" Text="0%" Foreground="#F44336"
                                   FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Lap / Sector / Delta (right-aligned) -->
                <StackPanel Grid.Column="10" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <TextBlock x:Name="DsLapSector" Text="LAP —" Foreground="#888888"
                               FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DsBestLap" Text="BEST  —" Foreground="#444444"
                               FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DsLastLap" Text="LAST  —" Foreground="#444444"
                               FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2 — Track map (left) + Right instrument panel                 -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Track canvas -->
            <Border Grid.Column="0" Background="#0D0D0D" ClipToBounds="True">
                <Canvas x:Name="TrackCanvas" Background="#0D0D0D"
                        MouseDown="TrackCanvas_MouseDown"
                        MouseMove="TrackCanvas_MouseMove"
                        MouseUp="TrackCanvas_MouseUp"
                        MouseWheel="TrackCanvas_MouseWheel"
                        Cursor="Hand">
                    <Image x:Name="TrackMapImage" Opacity="0.7" Stretch="Fill" Panel.ZIndex="-1"/>
                </Canvas>
            </Border>

            <!-- Column divider -->
            <Rectangle Grid.Column="1" Fill="#1A1A1A"/>

            <!-- Right instrument panel -->
            <Grid Grid.Column="2" Background="#0A0A0A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>   <!-- Steering wheel + pedal bars -->
                    <RowDefinition Height="1"/>      <!-- Divider -->
                    <RowDefinition Height="*"/>      <!-- Session / timing data -->
                    <RowDefinition Height="1"/>      <!-- Divider -->
                    <RowDefinition Height="40"/>     <!-- Detail popout button -->
                </Grid.RowDefinitions>

                <!-- Steering wheel + input bars -->
                <Canvas x:Name="PedalCanvas" Grid.Row="0" Background="#080808"/>

                <Rectangle Grid.Row="1" Fill="#1A1A1A"/>

                <!-- Session data -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TelemetryDataPanel" Margin="12,10"/>
                </ScrollViewer>

                <Rectangle Grid.Row="3" Fill="#1A1A1A"/>

                <!-- Detail popout button -->
                <Border Grid.Row="4" Background="#0A0A0A">
                    <Button x:Name="OpenDetailWindowButton" Click="OpenDetailWindowButton_Click"
                            Content="DETAIL VIEW  &#x25BA;"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" Foreground="#444444"
                            BorderBrush="#1E1E1E" BorderThickness="0,0,0,0"
                            FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#111111"/>
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 3 — Channel traces (MoTeC-style, full width)                  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#080808" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Channel labels column -->
                    <ColumnDefinition Width="110"/>
                    <!-- Trace canvas -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Channel label panel (live values + channel name) -->
                <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="ChannelLabelsPanel" VerticalAlignment="Stretch" Margin="0"/>
                </Border>

                <!-- Trace canvas — InputGraphCanvas fills the rest -->
                <Canvas x:Name="InputGraphCanvas" Grid.Column="1"
                        Background="#080808"
                        MouseDown="InputGraphCanvas_MouseDown"
                        MouseMove="InputGraphCanvas_MouseMove"
                        MouseUp="InputGraphCanvas_MouseUp"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
