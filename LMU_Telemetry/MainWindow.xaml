<Window x:Class="LMU_Telemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LMU_Telemetry.Views"
        Title="LMU Telemetry - Live Analysis" Height="900" Width="1600"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Panel.ZIndex="10">
            <Grid Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                <!-- Stylish Play/Pause Button -->
                <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" 
                        Width="40" Height="40" Margin="5" VerticalAlignment="Center"
                        Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="2"
                        Cursor="Hand" ToolTip="Play/Pause">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Path x:Name="PlayPauseIcon" 
                          Fill="#007ACC" 
                          Data="M8,5 L8,35 L28,20 Z"
                          Stretch="Uniform"
                          Width="18" Height="18"/>
                </Button>
                
                <TextBlock x:Name="StatusText" Text="Paused" Foreground="#FFA500" 
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock x:Name="FrameCountText" Text="Frames: 0" Foreground="#CCCCCC" 
                           FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="LapInfoText" Text="Drag player icon to scrub" Foreground="#569CD6" 
                           FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                
                <!-- Speed Control Buttons -->
                <Button x:Name="Speed2xButton" Click="Speed2xButton_Click" 
                        Content="2x" Height="30" Width="40" Padding="5,0"
                        Background="#555555" Foreground="White" 
                        BorderBrush="#777777" BorderThickness="1"
                        Cursor="Hand" ToolTip="2x playback speed"
                        Margin="20,0,0,0" VerticalAlignment="Center"
                        FontWeight="Bold">
                </Button>
                
                <Button x:Name="Speed4xButton" Click="Speed4xButton_Click" 
                        Content="4x" Height="30" Width="40" Padding="5,0"
                        Background="#555555" Foreground="White" 
                        BorderBrush="#777777" BorderThickness="1"
                        Cursor="Hand" ToolTip="4x playback speed"
                        Margin="5,0,0,0" VerticalAlignment="Center"
                        FontWeight="Bold">
                </Button>

                <Button x:Name="PrevLapButton" Click="PrevLapButton_Click" 
                    Content="⟲ Prev Lap" Height="30" Width="90" Padding="6,0"
                    Background="#555555" Foreground="White" 
                    BorderBrush="#777777" BorderThickness="1"
                    Cursor="Hand" ToolTip="Jump to previous lap at current distance"
                    Margin="15,0,0,0" VerticalAlignment="Center"
                    FontWeight="Bold">
                </Button>

                <Button x:Name="NextLapButton" Click="NextLapButton_Click" 
                    Content="Next Lap ⟳" Height="30" Width="90" Padding="6,0"
                    Background="#555555" Foreground="White" 
                    BorderBrush="#777777" BorderThickness="1"
                    Cursor="Hand" ToolTip="Jump to next lap at current distance"
                    Margin="5,0,0,0" VerticalAlignment="Center"
                    FontWeight="Bold">
                </Button>

                <CheckBox x:Name="TrackMapToggle" IsChecked="True" Content="Show Map" Margin="15,0,0,0" VerticalAlignment="Center"
                          Foreground="#CCCCCC" Checked="TrackMapToggle_Checked" Unchecked="TrackMapToggle_Checked"/>
                
                <!-- Load Recording Button -->
                <Button x:Name="LoadRecordingButton" Click="LoadRecordingButton_Click" 
                        Content="📁 Load Recording" Height="30" Padding="10,0"
                        Background="#0E639C" Foreground="White" 
                        BorderBrush="#1177BB" BorderThickness="1"
                        Cursor="Hand" ToolTip="Load telemetry recording from DuckDB file"
                        Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1177BB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Generate Track Map Button -->
                <Button x:Name="GenerateTrackMapButton" Click="GenerateTrackMapButton_Click" 
                        Content="🗺️ Generate Track Map" Height="30" Padding="10,0"
                        Background="#0E8C39" Foreground="White" 
                        BorderBrush="#0FA843" BorderThickness="1"
                        Cursor="Hand" ToolTip="Generate canonical track map from the loaded replay (2+ laps required, 9+ recommended)"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0FA843"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Delete Track Map Button -->
                <Button x:Name="DeleteTrackMapButton" Click="DeleteTrackMapButton_Click" 
                        Content="🗑️ Delete Track Map" Height="30" Padding="10,0"
                        Background="#8C0E0E" Foreground="White" 
                        BorderBrush="#A80F0F" BorderThickness="1"
                        Cursor="Hand" ToolTip="Delete the current track map to allow regeneration"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#A80F0F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <!-- Time Navigation Slider -->
                    <Slider x:Name="TimeSlider" Grid.Column="0"
                            Margin="0"
                            Minimum="0" Maximum="100" Value="0"
                            ValueChanged="TimeSlider_ValueChanged"
                            IsEnabled="False"
                            Foreground="#007ACC" Background="#3E3E42"
                            HorizontalAlignment="Stretch"
                            ToolTip="Drag to navigate through time"/>
                    <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00.000" Foreground="#CCCCCC" 
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Track Map Canvas -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" Margin="5" BorderBrush="#3E3E42" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="TrackCanvas" Background="#1E1E1E" 
                    MouseDown="TrackCanvas_MouseDown"
                    MouseMove="TrackCanvas_MouseMove"
                    MouseUp="TrackCanvas_MouseUp"
                    MouseWheel="TrackCanvas_MouseWheel"
                    Cursor="Hand">
                    <!-- Track map background image (optional, loaded at runtime) -->
                    <Image x:Name="TrackMapImage" Opacity="0.8" Stretch="Fill" Panel.ZIndex="-1"/>
                </Canvas>
                
                <!-- Track map controls - REMOVED: Using MoTeC-style centerline, no manual calibration needed -->
                <!--
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button x:Name="CalibrationHelperButton" Click="CalibrationHelper_Click"
                            Content="Calibration Helper" Padding="10,5"
                            Background="#0E639C" Foreground="White" BorderBrush="#007ACC"/>
                </StackPanel>
                -->
            </Grid>
        </Border>

        <!-- Telemetry Data Tabs -->
        <TabControl Grid.Row="1" Grid.Column="1" Background="#252526" 
                    BorderBrush="#3E3E42" BorderThickness="1"
                    Margin="5">
            <TabControl.Resources>
                <!-- Tab Item Style -->
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid>
                                    <Border x:Name="Border" Background="#2D2D30" 
                                            BorderBrush="#3E3E42" BorderThickness="1,1,1,0"
                                            Margin="2,0,2,0" CornerRadius="3,3,0,0">
                                        <TextBlock Text="{TemplateBinding Header}" 
                                                   Foreground="#CCCCCC" 
                                                   FontSize="11" FontWeight="Bold"
                                                   Padding="12,6"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </Style>
            </TabControl.Resources>

            <!-- Main Telemetry Tab -->
            <TabItem Header="📊 MAIN">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TelemetryDataPanel" Margin="10"/>
                </ScrollViewer>
            </TabItem>

            <!-- Detailed Data Tab -->
            <TabItem Header="📈 DETAILS">
                <local:DetailedDataView x:Name="DetailedDataView"/>
            </TabItem>

            <!-- Detailed Analysis Tab -->
            <TabItem Header="🧭 DETAILED ANALYSIS">
                <local:DetailedAnalysisView x:Name="DetailedAnalysisViewControl"/>
            </TabItem>
        </TabControl>

        <!-- Input Visualization Area -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1E1E1E" Margin="5" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pedal Display -->
                <Border Grid.Column="0" Background="#252526" Margin="5" BorderBrush="#3E3E42" BorderThickness="1">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="INPUTS" Foreground="#569CD6" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Canvas x:Name="PedalCanvas" Grid.Row="1" Background="#1E1E1E"/>
                    </Grid>
                </Border>

                <!-- Input Graphs -->
                <Border Grid.Column="1" Background="#252526" Margin="5" BorderBrush="#3E3E42" BorderThickness="1">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="INPUT HISTORY" Foreground="#569CD6" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Canvas x:Name="InputGraphCanvas" Grid.Row="1" Background="#1E1E1E"
                                MouseDown="InputGraphCanvas_MouseDown"
                                MouseMove="InputGraphCanvas_MouseMove"
                                MouseUp="InputGraphCanvas_MouseUp"
                                Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

