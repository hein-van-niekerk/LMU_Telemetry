<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- UseWindowsForms implicitly pulls in global usings for System.Windows.Forms and
       System.Drawing, which collide with WPF's System.Windows / System.Windows.Media
       namespaces (CheckBox, MessageBox, Button, Color, Brush, etc.). WinForms is only
       needed for FolderBrowserDialog, which is already accessed via an explicit alias
       (WinForms = System.Windows.Forms), so drop the global usings project-wide. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data" Version="1.1.3" />
    <PackageReference Include="DuckDB.NET.Bindings.Full" Version="1.1.3" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Svg.Skia" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\TrackMaps\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\wheel_silhouette.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <Target Name="CopyDuckDBNative" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\duckdb.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)runtimes\win-x64\native\duckdb.dll')" />
  </Target>

</Project>
